<?xml version='1.0' encoding='utf-8'?>
<widget id="com.tilesandbox.app" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>TILESANDBOX</name>
    <description>2.5D seamless sandbox — 79200 x 12800 px world of 16px tiles.</description>
    <content src="index.html" />

    <preference name="Fullscreen" value="true" />
    <preference name="Orientation" value="landscape" />
    <preference name="DisallowOverscroll" value="true" />
    <preference name="AutoHideSplashScreen" value="true" />
    <preference name="SplashScreenDelay" value="1200" />
    <preference name="SplashMaintainAspectRatio" value="true" />
    <preference name="KeepRunning" value="true" />
    <preference name="LoadUrlTimeoutValue" value="60000" />
    <preference name="BackgroundColor" value="#FF0B1020" />
    <preference name="AndroidXEnabled" value="true" />
    <preference name="android-minSdkVersion" value="24" />
    <preference name="android-targetSdkVersion" value="34" />
    <preference name="AndroidXAppCompatVersion" value="1.7.0" />
    <preference name="AndroidPersistentFileLocation" value="Internal" />

    <platform name="android">
        <preference name="AndroidLaunchMode" value="singleTop" />
    </platform>

    <engine name="android" spec="^15.1.0" />
</widget>
